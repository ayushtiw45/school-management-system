APP_NAME="TDS School Management Software"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Desktop build: data folder, APP_KEY and APP_URL are set by launch.ps1
TDS_DESKTOP=true
TDS_VERSION=__VERSION__

LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=480
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# Licensing
LICENSE_PUBLIC_KEY=__LICENSE_PUBLIC_KEY__
LICENSE_TRIAL_DAYS=__TRIAL_DAYS__
TDS_VENDOR_NAME="TDS School Management Software"
TDS_VENDOR_PHONE="__VENDOR_PHONE__"
TDS_VENDOR_WHATSAPP="__VENDOR_WHATSAPP__"
TDS_VENDOR_EMAIL="__VENDOR_EMAIL__"
TDS_VENDOR_WEBSITE="__VENDOR_WEBSITE__"

SMS_DRIVER=log
WHATSAPP_DRIVER=log
